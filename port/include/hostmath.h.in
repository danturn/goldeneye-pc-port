#ifndef PORT_HOSTMATH_H
#define PORT_HOSTMATH_H
/* Generated by CMake from hostmath.h.in — do not edit.
 * Includes the HOST <math.h> by absolute path so that port/shim/math.h can
 * give C++ TUs the real math header (the decomp's include/math.h is a
 * constants-only stub that shadows the system one via -I, leaving
 * acosf/fmodf/fabsf/... implicitly declared). */
#include "@PORT_HOST_MATH_H@"
#if @PORT_HAVE_LIBCPP@ && defined(__cplusplus)
/* libc++'s own <math.h> wrapper. <cmath> includes <math.h> and then requires
 * libc++'s _LIBCPP_MATH_H guard, which only that wrapper defines; it also
 * declares the std::__math overloads. Must come after the C header, because
 * pulled in by absolute path its #include_next <math.h> cannot find the C
 * header itself. See docs/dev/findings.md D295. */
#include "@PORT_LIBCPP_MATH_H@"
#endif
#endif
